NODE_ENV=production

# PostgreSQL
DATABASE_URL="postgresql://postgres.rdxaymtpzvkgbeogntmo:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
