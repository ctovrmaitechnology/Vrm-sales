# WhatsApp
ENABLE_WHATSAPP=false
WHATSAPP_DYNAMIC_URL_BUTTON=false
WHATSAPP_DYNAMIC_URL_BUTTON_INDEX=1
WHATSAPP_DYNAMIC_URL_BUTTON_INDEXES=0,1
WHATSAPP_TOKEN=replace_me
PHONE_NUMBER_ID=replace_me
